{
  "manifest_version": 2,
  "name": "AI 侧栏深色模式",
  "version": "1.0.3",
  "description": "为 Zotero AI Sidebar 提供深色、浅色和跟随 Zotero 的主题，保留现有插件功能。",
  "author": "Local Zotero Setup",
  "applications": {
    "zotero": {
      "id": "zotero-ai-sidebar-dark-mode@local",
      "strict_min_version": "7.0",
      "strict_max_version": "10.*",
      "update_url": "https://localhost/zotero-ai-sidebar-dark-mode/updates.json"
    }
  }
}
