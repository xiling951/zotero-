pdf2zh-pref-title = Zotero PDF2zh
pdf2zh-pref-help = { $name } Build { $version } { $time }

pdf2zh-pref-config          = Zotero PDF2zh配置
pdf2zh-pref-config-basic    = PDF2zh翻译配置
pdf2zh-pref-serverip        = Python服务器IP地址
pdf2zh-pref-engine          = 翻译引擎
pdf2zh-pref-service         = 翻译服务
pdf2zh-pref-threadNum       = 翻译线程数
pdf2zh-pref-qps             = 最大QPS(每秒请求数)
pdf2zh-pref-poolSize        = 最大并发Worker数(0=跟随QPS)
pdf2zh-pref-rename          = 重命名条目为短标题(如'短标题-dual', 实际文件名不变)
pdf2zh-pref-showProgress    = 在 Zotero 右下角显示翻译进度
pdf2zh-pref-skipLastPages   = 最后几页跳过翻译

pdf2zh-pref-sourceLang      = 源语言
pdf2zh-pref-targetLang      = 目标语言

# pdf1x
pdf2zh-pref-babeldoc        = 启用Babeldoc(Experimental)
pdf2zh-pref-skipSubsetFonts = 跳过字体子集化(渲染失败时尝试, 生成文件大小更大)
pdf2zh-pref-fontFile        = 上传字体文件
pdf2zh-pref-clear =
    .label = 清除

# pdf2x
pdf2zh-pref-ocr             = 强制开启OCR版临时解决方案（不推荐）
pdf2zh-pref-autoOcr         = 自动开启OCR版临时解决方案
pdf2zh-pref-transFirst      = 双语(Dual)译文在前（左右模式时译文在左）
pdf2zh-pref-noWatermark     = 无水印模式
pdf2zh-pref-fontFamily      = 选择字体
pdf2zh-pref-dualMode        = 双语(Dual)文件显示模式
pdf2zh-pref-pdf1x-config-title = pdf2zh 1.x 配置
pdf2zh-pref-pdf2x-config-title = pdf2zh 2.x 配置
pdf2zh-pref-dualMode-lr     = 左右对照
pdf2zh-pref-dualMode-tb     = 原文/译文交替页
pdf2zh-pref-saveGlossary    = 保存自动提取术语表
pdf2zh-pref-disableGlossary = 禁用自动术语提取
pdf2zh-pref-noDual          = 不生成双语(Dual)文件
pdf2zh-pref-noMono          = 不生成单语(Mono)文件
pdf2zh-pref-enhanceCompatibility         = 增强兼容性(会启用跳过清理、禁用富文本翻译，并可能使译文在前)
pdf2zh-pref-skipClean                    = 跳过清理步骤(可能增强兼容性)
pdf2zh-pref-disableRichTextTranslate     = 禁用富文本翻译(可能增强兼容性)
pdf2zh-pref-translateTableText           = 翻译表格文本(Experimental)
pdf2zh-pref-onlyIncludeTranslatedPage    = 仅保留实际翻译的页面(仅设置跳过/选择页面时生效)

pdf2zh-pref-gen           = 默认生成文件
pdf2zh-pref-open          = 生成后自动打开
pdf2zh-pref-mono          = 生成mono文件 (仅包含翻译语言)
pdf2zh-pref-dual          = 生成dual文件 (双语对照)
pdf2zh-pref-mono-cut      = 生成单栏mono文件 (适配手机阅读)
pdf2zh-pref-dual-cut      = 生成单栏dual文件 (适配手机阅读)
pdf2zh-pref-crop-compare  = 生成双语对照文件 (竖向切割后左右拼接）
pdf2zh-pref-compare       = 生成双语对照文件 (直接左右拼接)

pdf2zh-pref-llmapi-services  = 翻译服务配置
pdf2zh-pref-llmapi-add       = 新增
pdf2zh-pref-llmapi-remove    = 删除
pdf2zh-pref-llmapi-edit      = 编辑
pdf2zh-pref-llmapi-activate  = 激活
pdf2zh-pref-llmapi-totop     = 置顶
pdf2zh-pref-check-connection = 检查连接
